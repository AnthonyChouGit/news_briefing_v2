# ==============================================================================
# News Briefing v2 — Environment Configuration Template
# Copy this file to `.env` (or `src/.env`) and replace placeholder secrets.
# ==============================================================================

# ─── Database (DbConfigSchema) ───────────────────────────────────────────
# PostgreSQL host. Use `news_db` when running inside Docker Compose,
# or `localhost` / your DB server hostname when running locally.
db_host=news_db
db_port=5432
# Credentials used by both the app (`BriefNewsRepository`) and the Postgres
# container (`docker-compose.yml` reads `db_user`, `db_password`, `db_name`).
db_user=your_db_user
db_password=your_db_password
db_name=news_db

# ─── AI Client (AIClientConfigSchema) ────────────────────────────────────
# API key for your LLM provider. Never commit real keys to version control.
ai_api_key=your_ai_api_key

# Upstream endpoint base URL and matching protocol type (`ai_provider_type`):
#   - openai:            OpenAI Responses API (`/responses`), e.g. https://api.openai.com/v1
#   - anthropic:         Anthropic Messages API (`/messages`), e.g. https://api.anthropic.com/v1
#   - openai-compatible: Chat Completions (`/chat/completions`) with structured outputs,
#                        e.g. https://opencode.ai/inference/go/openai/v1
ai_base_url=https://api.openai.com/v1
ai_model=gpt-4o-mini
ai_provider_type=openai

# Reasoning effort passed to reasoning/thinking models (optional).
# Valid values: low, medium, high, xhigh, max
ai_reasoning_effort=medium

# HTTP request timeout in milliseconds (default: 300000)
ai_timeout=300000
# Number of automatic retries on transient errors; 0 disables retries (default: 3)
ai_max_retries=3
# Explicit max output token limit; avoids 4096-token compatibility caps on third-party models (schema default: 16384)
ai_max_output_tokens=65536

# ─── Categories & 3-Stage Selection Counts (SelectStageConfigSchema) ──────
# Supported categories (`NewsCategorySchema` in src/operators/common/BriefNews.schema.ts):
#   - international : World & global news (BBC World, CNN, Al Jazeera, France 24, Google News)
#   - china         : China domestic news & developments (Global Times China, China Daily China,
#                     CGTN China, China News Service China/Finance, ECNS, BBC China)
#   - ai            : Artificial intelligence & tech (TechCrunch AI, Google News AI, QbitAI, TMTPost, InfoQ CN)
#   - sports        : Focused sports feed covering Football (including Real Madrid), Formula 1,
#                     Baseball (MLB) & Table Tennis (WTT) (BBC Sport Football/F1, The Guardian Football,
#                     MLB.com, Google News, Marca, Managing Madrid, Football Espana, Formula 1,
#                     RaceFans, Motorsport.com)
#
# Comma-separated list of active categories to fetch (`fetch_news`) and query history for (`history_news`).
# Any valid subset of: international, china, ai, sports
categories=international, china, ai, sports

# JSON maps specifying how many top-ranked articles to retain per category at each selection stage.
# Any category omitted from a stage map will be dropped at that stage; keys should match `categories`.
# Recommended funnel: pre_read >= pre_summarize >= post_summarize so enough candidates survive
# scraping failures, recency filtering, and summarization quality checks.
pre_read_select_count_by_category={"international": 12, "china": 12, "ai": 10, "sports": 10}
pre_summarize_select_count_by_category={"international": 6, "china": 6, "ai": 5, "sports": 5}
post_summarize_select_count_by_category={"international": 3, "china": 3, "ai": 2, "sports": 3}

# ─── Ranking Preferences (RankNewsOptionsSchema) ─────────────────────────
# Optional comma-separated (or JSON array) list of preferred interest keywords.
# Matching articles receive a mild importance nudge during ranking without crowding out major news.
# rank_keywords=China
# Optional comma-separated (or JSON array) list of target sports to retain and balance in `sports`.
# Omit or leave empty to keep all fetched sports unfiltered.
# rank_sports=Football, Baseball, Table Tennis, F1

# ─── Fetch Options (FetchOptionsSchema) ──────────────────────────────────
# Optional overrides for RSS/HTML ingestion workers (defaults work out of the box):
# fetch_timeout=30000
# Max Google News redirect URLs decoded per RSS feed (worker default: 5)
fetch_max_decode_items=10
# Max items retained per source/feed (default: 20)
fetch_max_items_per_source=20
# fetch_user_agent=Mozilla/5.0

# ─── Read Options (ReadOptionsSchema) ────────────────────────────────────
# Optional overrides for full-article scraping workers:
# read_timeout=30000
# read_user_agent=Mozilla/5.0
# Optional character cap per scraped `raw` article body (default: unlimited)
# read_max_body_chars=50000

# ─── History, Pruning & Recency Windows ──────────────────────────────────
# Lookback window (hours) queried by `history_news` for dedupe & novelty ranking (default: 72)
history_time_window_hours=72
# Retention threshold (hours); `prune_news` deletes DB records older than this age
prune_older_than_hours=720
# Max article age (hours) allowed by `filter_recency` after scraping timestamps (default: 24)
filter_recency_td_hours=48

# ─── Summarization Options (SummarizeNewsOptionsSchema) ──────────────────
# Target language for summarized headlines, bullet points, and exported filenames (`latest_<language>.json`).
# Supported values: English, Chinese, Spanish, French, German, Italian, Portuguese, Russian, Japanese, Korean
language=Chinese
# Desired character range per bullet point and bullet count bounds per article
summarize_min_chars=50
summarize_max_chars=120
summarize_min_bullets=3
summarize_max_bullets=4

# ─── Export Options (ExportNewsOptionsSchema) ────────────────────────────
# Directory where `latest_<language>.json` and rotated `previous_<language>.json` are written.
# When using docker-compose.yml, `./exports` is mounted to `/app/exports`.
export_dir=./exports

# ─── Cron Schedule (CronConfigSchema) ────────────────────────────────────
# Required when running the daemon entrypoint (`dist/cron_main.js`); optional for one-shot `dist/main.js`.
# Standard 5-field cron expression (e.g. 08:00, 12:00, 18:00, 22:00 daily)
cron_expr=0 8,12,18,22 * * *
# IANA timezone name used by CronJob (optional; defaults to container/system timezone)
time_zone=Asia/Shanghai

# ─── DAG Execution (DagConfigSchema) ─────────────────────────────────────
# Maximum total milliseconds allowed per DAG run before cooperative AbortSignal cancellation (optional)
dag_timeout=900000
# Enable verbose LightDAG topology validation & per-operator execution logs (`true` / `false`, default: false)
debug=false
